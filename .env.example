# sshoPS-Agent 配置示例

# ============================================================
# 通用 LLM 配置（推荐：兼容 LiteLLM / OneAPI / 自建 OpenAI 代理）
# ============================================================
# LLM_PROVIDER: anthropic | openai
# LLM_API_KEY:  对应 Provider 的 API 密钥
# LLM_BASE_URL: 自定义 base URL（用于代理、自建服务等）
# LLM_MODEL:    模型名（如 deepseek_70b、gpt-4o、claude-3-5-sonnet-20241022）
# ============================================================
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 兼容旧版 provider-specific 变量（推荐使用上方 LLM_* 通用形式）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 日志级别：trace | debug | info | warn | error | fatal
SSHOPS_LOG_LEVEL=info

# 指标端口（0 表示不启用）
SSHOPS_METRICS_PORT=0

# Agent 行为
SSHOPS_MAX_DURATION_SECONDS=600
SSHOPS_MAX_STEPS=30
SSHOPS_TOOL_TIMEOUT_SECONDS=60
